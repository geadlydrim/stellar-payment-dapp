# Copy to `.env.local` — never commit real keys or `.env.local`.

# Marketplace adapter: `mock` (default) | `stellar`
# Stellar is used only when adapter=stellar AND all four contract IDs below are set;
# otherwise composition root keeps mocks (safe default).
NEXT_PUBLIC_MARKET_ADAPTER=mock

# Phase D contract IDs (Stellar testnet, start with C). Fill after deploy — see contracts/README.md.
# Deploy order: item-nft → auction (NFT settle WASM) → fixed-price → offer-board.
# Players self-mint (`mint(self, self, item_id)`). `set_minter` is optional and only for
# mint-to-other / airdrop — not required for export.
# item-nft has no upgrade: a new WASM needs a new C… plus redeploy of sale/trade against it.
# Auction can keep its ID (each listing passes nft_contract). Old NFT tokens are abandoned.
NEXT_PUBLIC_ITEM_NFT_CONTRACT_ID=
# Auction: NFT-capable deploy (storage layout changed vs the original XLM-only contract).
NEXT_PUBLIC_AUCTION_CONTRACT_ID=
NEXT_PUBLIC_FIXED_PRICE_CONTRACT_ID=
NEXT_PUBLIC_OFFER_BOARD_CONTRACT_ID=

# Optional: Soroban RPC / network overrides (defaults target testnet in app code)
# NEXT_PUBLIC_SOROBAN_RPC_URL=
# NEXT_PUBLIC_STELLAR_NETWORK=testnet
